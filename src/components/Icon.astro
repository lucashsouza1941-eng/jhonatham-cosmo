---
// Ícones em SVG de linha, herdam a cor do texto (currentColor).
interface Props {
  name: 'whatsapp' | 'instagram' | 'tiktok' | 'menu' | 'close' | 'sun' | 'moon';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" />
      <path d="M9 8.2c.3-.6.7-.6 1-.6.3 0 .5 1.3.8 1.9.1.3-.5.9-.6 1.1.6 1.3 1.6 2.3 2.9 2.9.2-.1.8-.8 1.1-.6.6.3 1.9.5 1.9.8 0 .3 0 .7-.6 1-.7.5-1.6.6-2.6.2-1.9-.7-3.5-2.3-4.2-4.2-.4-1-.3-1.9.2-2.5z" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="3.8" />
      <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" />
    </>
  )}
  {name === 'tiktok' && (
    <path d="M14 3.5v11.2a3.8 3.8 0 1 1-3.8-3.8M14 3.5c.4 2.6 2.2 4.3 4.7 4.5" />
  )}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    </>
  )}
  {name === 'moon' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />}
</svg>

<style>
  .icon { display: block; flex-shrink: 0; }
</style>
