---
import Icon from './Icon.astro';
import { nav, paginaAtual, whatsappUrl } from '../data/site';
---
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/">Jhonatham<span>Cosmo</span></a>
    <nav class="nav" aria-label="Principal">
      {nav.map((item) => <a href={item.href} aria-current={paginaAtual(item.href, Astro.url.pathname) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="icons">
      <button class="theme-btn" type="button" aria-label="Ativar modo claro" title="Alternar tema">
        <span class="when-dark"><Icon name="sun" size={21} /></span>
        <span class="when-light"><Icon name="moon" size={21} /></span>
      </button>
      <a href={whatsappUrl('Olá! Gostaria de saber mais sobre as obras do Jhonatham Cosmo.')} target="_blank" rel="noopener" aria-label="WhatsApp">
        <Icon name="whatsapp" size={22} />
      </a>
      <button class="menu-btn" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-mobile">
        <span class="when-closed"><Icon name="menu" size={24} /></span>
        <span class="when-open"><Icon name="close" size={24} /></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="menu-mobile" aria-label="Menu" hidden>
    {nav.map((item) => <a href={item.href} aria-current={paginaAtual(item.href, Astro.url.pathname) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</header>

<script>
  // Tema: o atributo já vem aplicado pelo script inline do <head> (Base.astro);
  // aqui só alterna e guarda a escolha.
  const temaBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
  if (temaBtn) {
    const raiz = document.documentElement;
    const sync = () => {
      const claro = raiz.dataset.theme === 'light';
      temaBtn.setAttribute('aria-label', claro ? 'Ativar modo escuro' : 'Ativar modo claro');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', claro ? '#f4f1ea' : '#090909');
    };
    sync();
    temaBtn.addEventListener('click', () => {
      const tema = raiz.dataset.theme === 'light' ? 'dark' : 'light';
      raiz.dataset.theme = tema;
      try { localStorage.setItem('tema', tema); } catch {}
      sync();
    });
  }

  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.querySelector<HTMLElement>('#menu-mobile');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };
    btn.addEventListener('click', () => setOpen(menu.hidden));
    // Fecha com Esc (os itens levam a outras páginas, que já abrem com ele fechado).
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>

<style>
  .topbar { border-bottom: 1px solid var(--line); background: var(--topbar); transition: background-color .25s; position: relative; z-index: 2; }
  .topbar-inner { height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  .icons { display: flex; align-items: center; gap: 18px; }
  .icons a:hover, .menu-btn:hover, .theme-btn:hover { color: var(--red-hover); }
  .theme-btn { background: none; border: 0; padding: 6px; margin: -6px; color: inherit; cursor: pointer; }
  :global(html[data-theme='light']) .theme-btn .when-dark,
  :global(html:not([data-theme='light'])) .theme-btn .when-light { display: none; }
  .nav a[aria-current='page'] { color: var(--red-hover); }
  .mobile-nav a[aria-current='page'] { color: var(--red-hover); border-left: 2px solid var(--red); }
  .menu-btn { display: none; background: none; border: 0; padding: 6px; margin: -6px; color: inherit; cursor: pointer; }
  .menu-btn[aria-expanded='true'] .when-closed,
  .menu-btn[aria-expanded='false'] .when-open { display: none; }
  .mobile-nav { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav a { padding: 16px 18px; font-size: 14px; letter-spacing: 2px; text-transform: uppercase; border-bottom: 1px solid var(--line); }
  .mobile-nav a:hover { color: var(--red-hover); }
  @media (max-width: 760px) {
    .topbar-inner { height: 68px; }
    .nav { display: none; }
    .menu-btn { display: block; }
  }
  @media (min-width: 761px) {
    .mobile-nav { display: none !important; }
  }
</style>
