---
import { beneficios } from '../data/site';
---
<section class="wrap benefits" aria-label="Vantagens">
  {beneficios.map((b) => (
    <div class="benefit">
      <div class="symbol" aria-hidden="true">{b.simbolo}</div>
      <div><strong>{b.titulo}</strong><small>{b.texto}</small></div>
    </div>
  ))}
</section>

<style>
  .benefits { display: grid; grid-template-columns: repeat(4, 1fr); padding: 22px 0; border-bottom: 1px solid var(--line); }
  .benefit { display: flex; align-items: center; gap: 13px; padding: 4px 18px; border-right: 1px solid var(--line); }
  .benefit:last-child { border: 0; }
  .symbol { font-size: 23px; border: 1px solid #36322e; border-radius: 50%; width: 46px; height: 46px; display: grid; place-items: center; flex-shrink: 0; }
  strong { display: block; font-size: 9px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px; }
  small { font-size: 10px; color: #a9a39d; }
  @media (max-width: 760px) {
    .benefits { grid-template-columns: repeat(2, 1fr); gap: 16px 0; }
    .benefit:nth-child(2) { border-right: 0; }
    .benefit { padding: 4px 8px; }
    .symbol { width: 38px; height: 38px; font-size: 18px; }
  }
  @media (max-width: 420px) {
    .benefit { gap: 8px; }
    strong { font-size: 8px; }
    small { font-size: 9px; }
  }
</style>
