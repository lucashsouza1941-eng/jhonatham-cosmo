---
import { lerConfig, lerInicio } from '../data/conteudo';

const [config, inicio] = await Promise.all([lerConfig(), lerInicio()]);
const [primeiro, ...resto] = config.nome.toUpperCase().split(' ');
---
<section class="hero" id="inicio" style={`--foto: url('${inicio.imagem}')`}>
  <div class="wrap">
    <div class="hero-content">
      <div class="eyebrow">{inicio.eyebrow}</div>
      <h1>{primeiro}{resto.length > 0 && <><br />{resto.join(' ')}</>}</h1>
      <p>{inicio.slogan}</p>
      <a class="btn" href="/obras">Explorar obras <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .hero { min-height: 390px; position: relative; overflow: hidden; background: var(--bg); display: flex; align-items: center; border-bottom: 1px solid var(--line); }
  .hero::before {
    content: ""; position: absolute; inset: 0; opacity: .92;
    background:
      linear-gradient(90deg, rgb(var(--overlay)) 0%, rgb(var(--overlay) / .93) 28%, rgb(var(--overlay) / .13) 67%, rgb(var(--overlay) / .56) 100%),
      var(--foto) center 42% / cover no-repeat;
  }
  .hero-content { position: relative; padding: 58px 0 46px; max-width: 560px; }
  h1 { font-size: clamp(42px, 6vw, 78px); line-height: .92; letter-spacing: 1px; margin: 22px 0 18px; font-weight: 900; }
  p { font-family: Georgia, serif; font-style: italic; font-size: 20px; line-height: 1.45; color: var(--text-2); max-width: 370px; margin: 0 0 25px; white-space: pre-line; }

  @media (max-width: 760px) {
    .hero { min-height: 440px; align-items: end; }
    .hero::before {
      background:
        linear-gradient(0deg, rgb(var(--overlay)) 0%, rgb(var(--overlay) / .85) 32%, rgb(var(--overlay) / .13) 100%),
        var(--foto) 57% center / cover no-repeat;
    }
    .hero-content { padding: 160px 0 35px; }
    h1 { font-size: clamp(43px, 12vw, 66px); }
    p { font-size: 18px; }
  }
</style>
