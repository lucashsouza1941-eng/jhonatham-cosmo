---
import { lerSobre } from '../data/conteudo';

const sobre = await lerSobre();
---
<section class="about">
  <div class="about-photo" style={`--foto: url('${sobre.foto}')`}>
    {sobre.fraseFoto && <div class="scribble" aria-hidden="true">{sobre.fraseFoto}</div>}
  </div>
  <div class="about-copy">
    <div class="eyebrow">{sobre.eyebrow}</div>
    <h1>{sobre.titulo}</h1>
    {sobre.paragrafos.map((p) => <p>{p}</p>)}
    <a class="btn" href="/contato">Fale comigo&nbsp; →</a>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 1fr 1fr; min-height: min(70vh, 640px); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .about-photo { background: linear-gradient(90deg, #0000, #0005), var(--foto) center / cover no-repeat; min-height: 340px; position: relative; }
  .scribble { position: absolute; left: 7%; top: 24%; font-weight: 900; font-style: italic; font-size: 27px; line-height: .95; transform: rotate(-9deg); color: #fff; text-shadow: 0 2px 8px #000; white-space: pre-line; }
  .about-copy { padding: 42px clamp(24px, 5vw, 70px); align-self: center; }
  h1 { font-size: clamp(28px, 4vw, 40px); letter-spacing: 1px; margin: 12px 0 16px; }
  p { font-size: 15px; line-height: 1.8; color: var(--text-2); max-width: 520px; white-space: pre-line; }
  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; }
    .about-photo { min-height: 250px; }
    .about-copy { padding: 32px 22px; }
  }
</style>
