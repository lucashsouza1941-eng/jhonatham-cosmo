---
import type { Obra } from '../data/obras';
import { formatarPreco } from '../data/obras';
import { whatsappUrl } from '../data/site';

interface Props { obra: Obra }
const { obra } = Astro.props;
const disponivel = obra.disponivel !== false;
const msgCompra = `Olá, tenho interesse na obra ${obra.titulo} do Jhonatham Cosmo. Ela está disponível?`;
const msgDuvida = `Olá! Gostaria de saber mais sobre a obra ${obra.titulo}.`;
---
<article class="art-card">
  <a href={`/obras/${obra.slug}`} class="thumb">
    <img src={obra.imagem} alt={`Obra autoral ${obra.titulo}`} loading="lazy" width="400" height="400" />
  </a>
  <h3><a href={`/obras/${obra.slug}`}>{obra.titulo.toUpperCase()}</a></h3>
  <p class="meta">{obra.tecnica} · {obra.dimensoes}</p>
  <p class="price">{disponivel ? formatarPreco(obra.preco) : 'Vendida'}</p>
  <div class="buy-row">
    {disponivel
      ? <a class="buy" href={whatsappUrl(msgCompra)} target="_blank" rel="noopener">Comprar</a>
      : <span class="buy sold">Indisponível</span>}
    <a class="wa" href={whatsappUrl(msgDuvida)} target="_blank" rel="noopener" aria-label={`Consultar ${obra.titulo} no WhatsApp`}>◉</a>
  </div>
</article>

<style>
  .thumb { display: block; overflow: hidden; }
  img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; filter: saturate(.9); border: 1px solid #ffffff20; transition: transform .35s, filter .35s; }
  .art-card:hover img { transform: translateY(-4px); filter: saturate(1.15); }
  h3 { font-size: 12px; font-weight: 500; letter-spacing: 1.5px; margin: 13px 0 7px; }
  .meta { font-size: 10px; color: #b5b0aa; margin: 0 0 9px; }
  .price { font-size: 13px; margin: 0 0 13px; }
  .buy-row { display: flex; gap: 8px; }
  .buy { padding: 10px 15px; min-width: 120px; border: 1px solid #8e3b30; text-align: center; font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; }
  .buy:hover { background: var(--red); }
  .buy.sold { border-color: #444; color: #777; cursor: default; }
  .buy.sold:hover { background: none; }
  .wa { width: 35px; border: 1px solid #555; display: grid; place-items: center; }
  .wa:hover { border-color: var(--red); }
  @media (max-width: 760px) {
    h3 { margin-top: 10px; }
    .buy { min-width: 0; flex: 1; }
  }
  @media (max-width: 420px) {
    h3 { font-size: 11px; }
    .meta { font-size: 9px; }
    .price { font-size: 12px; }
  }
</style>
