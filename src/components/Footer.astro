---
import { nav, site, whatsappUrl } from '../data/site';
const ano = new Date().getFullYear();
---
<footer class="wrap footer">
  <a class="brand" href="/#inicio">Jhonatham<span>Cosmo</span></a>
  <nav class="nav" aria-label="Rodapé">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="footer-right">
    <div class="social">
      <a href={site.redes.instagram} target="_blank" rel="noopener" aria-label="Instagram">◎</a>
      <a href={whatsappUrl('Olá! Gostaria de saber mais sobre as obras do Jhonatham Cosmo.')} target="_blank" rel="noopener" aria-label="WhatsApp">◉</a>
      <a href={site.redes.tiktok} target="_blank" rel="noopener" aria-label="TikTok">♪</a>
    </div>
    <div class="copyright">JHONATHAM COSMO · © {ano} · TODOS OS DIREITOS RESERVADOS</div>
  </div>
</footer>

<style>
  .footer { padding: 25px 0; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .footer .nav { gap: 22px; font-size: 9px; }
  .social { display: flex; gap: 15px; font-size: 14px; justify-content: flex-end; }
  .social a:hover { color: var(--red-hover); }
  .copyright { font-size: 8px; color: #88837e; letter-spacing: .7px; margin-top: 9px; text-align: right; }
  @media (max-width: 760px) {
    .footer { flex-wrap: wrap; }
    .footer .nav { order: 3; width: 100%; justify-content: space-between; }
    .footer-right { margin-left: auto; }
  }
</style>
