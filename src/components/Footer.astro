---
import Icon from './Icon.astro';
import { nav, whatsappUrl } from '../data/site';
import { lerConfig } from '../data/conteudo';
const config = await lerConfig();
const ano = new Date().getFullYear();
---
<footer class="wrap footer">
  <a class="brand" href="/">Jhonatham<span>Cosmo</span></a>
  <nav class="nav" aria-label="Rodapé">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="footer-right">
    <div class="social">
      {config.instagram && <a href={config.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>}
      <a href={whatsappUrl('Olá! Gostaria de saber mais sobre as obras do Jhonatham Cosmo.')} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
      {config.tiktok && <a href={config.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" /></a>}
    </div>
    <div class="copyright">{config.nome.toUpperCase()} · © {ano} · TODOS OS DIREITOS RESERVADOS</div>
  </div>
</footer>

<style>
  .footer { padding: 25px 0; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .footer .nav { gap: 22px; font-size: 12px; }
  .social { display: flex; gap: 18px; justify-content: flex-end; }
  .social a:hover { color: var(--red-hover); }
  .copyright { font-size: 11px; color: var(--muted); letter-spacing: .7px; margin-top: 10px; text-align: right; }
  @media (max-width: 760px) {
    .footer { flex-wrap: wrap; }
    .footer .nav { order: 3; width: 100%; justify-content: space-between; }
    .footer-right { margin-left: auto; }
    .copyright { font-size: 11px; }
  }
</style>
