---
import Base from '../../layouts/Base.astro';
import { obras, formatarPreco, type Obra } from '../../data/obras';
import { whatsappUrl } from '../../data/site';

export function getStaticPaths() {
  return obras.map((obra) => ({ params: { slug: obra.slug }, props: { obra } }));
}

const { obra } = Astro.props as { obra: Obra };
const disponivel = obra.disponivel !== false;
const descricao = obra.descricao ?? `${obra.titulo} — obra autoral de Jhonatham Cosmo. ${obra.tecnica}, ${obra.dimensoes}.`;
---
<Base title={`${obra.titulo} — Jhonatham Cosmo`} description={descricao} image={obra.imagem}>
  <section class="section">
    <div class="wrap detail">
      <img src={obra.imagem} alt={`Obra autoral ${obra.titulo}`} width="600" height="600" />
      <div class="info">
        <a class="text-link" href="/obras">← Todas as obras</a>
        <div class="eyebrow" style="margin-top:28px">Obra autoral</div>
        <h1>{obra.titulo.toUpperCase()}</h1>
        <p class="meta">{obra.tecnica} · {obra.dimensoes}</p>
        <p class="price">{disponivel ? formatarPreco(obra.preco) : 'Vendida'}</p>
        <p class="desc">{descricao}</p>
        {disponivel
          ? <a class="btn" href={whatsappUrl(`Olá, tenho interesse na obra ${obra.titulo} do Jhonatham Cosmo. Ela está disponível?`)} target="_blank" rel="noopener">Comprar pelo WhatsApp&nbsp; →</a>
          : <a class="btn" href={whatsappUrl(`Olá! Vi que a obra ${obra.titulo} foi vendida. Você faz encomendas parecidas?`)} target="_blank" rel="noopener">Encomendar algo parecido&nbsp; →</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .detail { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border: 1px solid var(--line-strong); }
  h1 { font-size: clamp(32px, 5vw, 56px); letter-spacing: 1px; margin: 10px 0 12px; font-weight: 900; }
  .meta { font-size: 12px; color: var(--muted); margin: 0 0 12px; }
  .price { font-size: 20px; margin: 0 0 20px; }
  .desc { font-family: Georgia, serif; font-style: italic; color: var(--text-2); line-height: 1.6; max-width: 460px; margin-bottom: 26px; }
  @media (max-width: 760px) { .detail { grid-template-columns: 1fr; gap: 26px; } }
</style>
