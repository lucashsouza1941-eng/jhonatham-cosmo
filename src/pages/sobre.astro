---
import Base from '../layouts/Base.astro';
import Sobre from '../components/Sobre.astro';
import Beneficios from '../components/Beneficios.astro';
import { lerSobre } from '../data/conteudo';

const sobre = await lerSobre();
---
<Base title="Sobre — Jhonatham Cosmo" description={sobre.paragrafos[0] ?? 'Conheça Jhonatham Cosmo, tatuador e artista.'} image={sobre.foto}>
  <Sobre />
  <Beneficios />
</Base>
