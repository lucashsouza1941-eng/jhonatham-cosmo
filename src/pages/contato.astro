---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { whatsappUrl } from '../data/site';
import { lerConfig, lerContato } from '../data/conteudo';

const [config, contato] = await Promise.all([lerConfig(), lerContato()]);

// Instagram e TikTok só aparecem se o link estiver preenchido no painel.
const canais = [
  { nome: 'WhatsApp', icone: 'whatsapp' as const, href: whatsappUrl('Olá, Jhonatham! Gostaria de conversar sobre suas obras.'), texto: 'Converse direto com o artista' },
  { nome: 'Instagram', icone: 'instagram' as const, href: config.instagram, texto: 'Acompanhe as obras' },
  { nome: 'TikTok', icone: 'tiktok' as const, href: config.tiktok, texto: 'Acompanhe as obras' },
].filter((c) => c.href);
---
<Base title="Contato — Jhonatham Cosmo" description={contato.texto} image={contato.imagem}>
  <section class="contact-hero" style={`--foto: url('${contato.imagem}')`}>
    <div class="wrap">
      <div class="eyebrow">Contato</div>
      <h1>{contato.titulo}</h1>
      <p>{contato.texto}</p>
      <a class="btn" href={whatsappUrl('Olá, Jhonatham! Gostaria de conversar sobre suas obras.')} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> Chamar no WhatsApp <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><div class="eyebrow">Como posso ajudar</div><h2>SOBRE O QUE VAMOS FALAR?</h2></div></div>
      <div class="motivos">
        {contato.motivos.map((m) => (
          <a class="motivo" href={whatsappUrl(m.mensagem)} target="_blank" rel="noopener">
            <strong>{m.titulo}</strong>
            <span>{m.texto}</span>
            <em>Conversar <span aria-hidden="true">→</span></em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section canais-sec">
    <div class="wrap">
      <div class="section-head"><div><div class="eyebrow">Canais</div><h2>ONDE ME ENCONTRAR</h2></div></div>
      <div class="canais">
        {canais.map((c) => (
          <a class="canal" href={c.href} target="_blank" rel="noopener">
            <Icon name={c.icone} size={28} />
            <div><strong>{c.nome}</strong><span>{c.texto}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-hero {
    padding: 80px 0 70px; border-bottom: 1px solid var(--line);
    background: linear-gradient(90deg, rgb(var(--overlay) / .95) 0%, rgb(var(--overlay) / .78) 55%, rgb(var(--overlay) / .5) 100%), var(--foto) center / cover no-repeat;
  }
  h1 { font-size: clamp(34px, 6vw, 64px); font-weight: 900; letter-spacing: 1px; margin: 16px 0 14px; }
  .contact-hero p { white-space: pre-line; font-family: Georgia, serif; font-style: italic; font-size: 19px; line-height: 1.5; color: var(--text-2); max-width: 520px; margin: 0 0 28px; }

  .motivos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .motivo { display: flex; flex-direction: column; gap: 10px; padding: 26px 24px; border: 1px solid var(--line); background: var(--panel); transition: border-color .2s; }
  .motivo:hover { border-color: var(--red); }
  .motivo strong { font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; }
  .motivo span { font-size: 14px; line-height: 1.6; color: var(--muted); }
  .motivo em { font-style: normal; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--red-hover); margin-top: auto; padding-top: 8px; }

  .canais-sec { border-top: 1px solid var(--line); }
  .canais { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .canal { display: flex; align-items: center; gap: 16px; padding: 20px 22px; border: 1px solid var(--line); transition: border-color .2s, color .2s; }
  .canal:hover { border-color: var(--red); color: var(--red-hover); }
  .canal strong { display: block; font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 4px; }
  .canal span { font-size: 13px; color: var(--muted); }

  @media (max-width: 760px) {
    .contact-hero { padding: 56px 0 48px; }
    .contact-hero p { font-size: 17px; }
    .motivos, .canais { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
